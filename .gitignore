#-------------------------
# Versioned project docs (DO track)
#-------------------------
# /docs  — technical documentation (charter, PRD, architecture, ops)
# /adr   — Architecture Decision Records
# These directories must remain under version control.
# Do not add ignore rules that would exclude them.

#-------------------------
# Operating System Junk
#-------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

#-------------------------
# Environment & Secrets
#-------------------------
# Never commit secrets or local env overrides.
.env
.env.*
!.env.example
.db_password
*.pem
*.key
!public/**/*.key

# Local VM tooling (if used)
.vagrant
Vagrantfile

#-------------------------
# CodeIgniter writable/*
#-------------------------
# Keep directory placeholders; ignore runtime contents.
/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

# Public image derivatives / local upload mirrors (never commit client media)
/public/uploads/*
!/public/uploads/index.html
!/public/uploads/images/
!/public/uploads/images/index.html
!/public/uploads/documents/
!/public/uploads/documents/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

php_errors.log

#-------------------------
# Dependencies
#-------------------------
/vendor/
/node_modules/

#-------------------------
# Frontend build artifacts
#-------------------------
# Tailwind/Vite compiled CSS/JS output (source stays tracked).
/public/assets/css/app.css
/public/build/
/public/hot

#-------------------------
# Design reference only (never deploy)
#-------------------------
# TailAdmin Free clone — local markup reference per .cursorrules §2.1
/reference/

#-------------------------
# Tests & coverage
#-------------------------
/tests/coverage*
/phpunit
/phpunit.xml
/results/
/.phpunit.result.cache
/.phpunit.cache/

#-------------------------
# User Guide build (framework; usually absent in appstarter)
#-------------------------
/user_guide_src/build/*
/user_guide_src/cilexer/build/*
/user_guide_src/cilexer/dist/*
/user_guide_src/cilexer/pycilexer.egg-info/*

#-------------------------
# IDE / Editor / Agent
#-------------------------
_modules/*
.php-version
.php-cs-fixer.cache
.phpstan.cache

# JetBrains
.idea/
*.iml

# NetBeans
/nbproject/
/build/
/nbbuild/
/dist/
/nbdist/
/nbactions.xml
/nb-configuration.xml
/.nb-gradle/

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
.phpintel

# VS Code / Cursor local settings
.vscode/
.cursor/
!.cursor/skills/
!.cursor/rules/

# Misc generated API dumps
/api/
