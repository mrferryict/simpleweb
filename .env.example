#--------------------------------------------------------------------
# SMITE CMS — Example Environment Configuration
#
# Copy this file to `.env` and fill in values for your environment.
# This file MUST contain only safe placeholders — never real secrets.
#
#   cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# 1. ENVIRONMENT
#--------------------------------------------------------------------
# Use `production` on live servers. Use `development` only on local workstations.

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# 2. APPLICATION
#--------------------------------------------------------------------
# Replace with your actual public URL (HTTPS recommended; trailing slash required).

app.baseURL = 'https://your-domain.example/'

app.forceGlobalSecureRequests = true
app.indexPage = ''
app.CSPEnabled = false
app.appTimezone = 'Asia/Jakarta'

# Session — file-backed baseline (ADR-009 / DOC-11).
# Default save path is WRITEPATH/session when unset.
# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath =

#--------------------------------------------------------------------
# 3. DATABASE
#--------------------------------------------------------------------
# MariaDB connection. Leave credentials empty in this template.

database.default.hostname = localhost
database.default.database = ''
database.default.username = ''
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Isolated test database (PHPUnit only — do not point tests at production data).
# database.tests.hostname = localhost
# database.tests.database = ''
# database.tests.username = ''
# database.tests.password =
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# 4. SECURITY KEYS
#--------------------------------------------------------------------
# Generate values before running `php spark cms:install`.
# Never commit real key material.

# CodeIgniter application encryption key.
# Write to .env:  php spark key:generate
# Preview only:   php spark key:generate --show
encryption.key =

# Admin recovery secret (long random value; never stored in the database).
# Example generator:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
skey =

# PII email keys (ADR-008) — each MUST be exactly 64 hexadecimal characters
# (= 32 bytes). EMAIL_ENCRYPTION_KEY and EMAIL_LOOKUP_HMAC_KEY MUST differ.
# Generate each (run twice; use different output for each key):
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
EMAIL_ENCRYPTION_KEY =
EMAIL_LOOKUP_HMAC_KEY =

#--------------------------------------------------------------------
# 5. CMS ADMIN CREDENTIALS (initial install only)
#--------------------------------------------------------------------
# Used only by `php spark cms:install` on a fresh system.
# These are administrator-provided install credentials — not demo credentials.
# There is no hard-coded Admin password in the application.
# Choose a unique initial password and change it after first login.
#
# Alternative (CLI flags override env when provided):
#   php spark cms:install \
#       --username admin \
#       --email admin@example.com \
#       --password 'YOUR_SECURE_PASSWORD'
#
# Use space-separated flags (`--username value`), not `--username=value`.

cms.install.admin_username = 'admin'
cms.install.admin_email = 'admin@example.com'
cms.install.admin_password =

#--------------------------------------------------------------------
# 6. SMTP (optional — required for password recovery in production)
#--------------------------------------------------------------------
# Leave credentials empty until SMTP is configured.
# Maps to Config\Email via CodeIgniter environment overrides.

email.fromEmail = 'noreply@example.com'
email.fromName = 'SMITE CMS'
email.protocol = smtp
email.SMTPHost = 'smtp.example.com'
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 587
email.SMTPCrypto = 'tls'

#--------------------------------------------------------------------
# 7. AUTH THROTTLE (operational configuration)
#--------------------------------------------------------------------
# Required authentication surfaces are wired in the application.
# Numeric throttle policy is NOT defined by the V1 product contract.
# Set BOTH capacity and seconds per surface in your deployment environment.
# If either value is missing or invalid, that surface fails closed (denied)
# until configured. Do not invent product rate numbers here.
#
# auth.throttle.login.capacity =
# auth.throttle.login.seconds =
# auth.throttle.password_reset_request.capacity =
# auth.throttle.password_reset_request.seconds =
# auth.throttle.password_reset_verify.capacity =
# auth.throttle.password_reset_verify.seconds =
# auth.throttle.admin_recovery.capacity =
# auth.throttle.admin_recovery.seconds =

#--------------------------------------------------------------------
# LOGGER (optional)
#--------------------------------------------------------------------
# logger.threshold = 4
