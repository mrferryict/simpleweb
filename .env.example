#--------------------------------------------------------------------
# SMITE CMS — Example Environment Configuration
#
# Copy this file to `.env` and fill in local/production values.
# This file MUST contain only safe placeholders — never real secrets.
#
#   cp .env.example .env
#
# Generate CI4 encryption.key with:
#   php spark key:generate
#
# Generate PII keys (64 hex chars each, MUST be different):
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://simpleweb.smite.local/'
app.forceGlobalSecureRequests = true
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Local development examples only. Leave password empty in this template.
# Never commit real database credentials.

database.default.hostname = localhost
database.default.database = simpleweb
database.default.username = simpleweb_user
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Isolated test database (do not point tests at development/production data).
# database.tests.hostname = localhost
# database.tests.database = simpleweb_test
# database.tests.username = simpleweb_user
# database.tests.password =
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION (CodeIgniter)
#--------------------------------------------------------------------
# Set via: php spark key:generate
# Do not paste production keys into this example file.

encryption.key =

#--------------------------------------------------------------------
# SESSION (ADR-011 — file-backed baseline)
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# ADMIN RECOVERY (CONTEXT.md / DOC-03)
#--------------------------------------------------------------------
# Long secret used only for emergency Admin recovery.
# Never store in the database. Never commit a real value.

skey =

#--------------------------------------------------------------------
# CMS INSTALL BOOTSTRAP (DOC-09 §5 / DOC-10 §63 / DOC-11 §11–12)
#--------------------------------------------------------------------
# Required only for a fresh install that creates the single Admin.
# Never commit real credentials. Prefer one-time env or CLI flags:
#   php spark cms:install --username … --email … --password …
#
# cms.install.admin_username =
# cms.install.admin_email =
# cms.install.admin_password =

#--------------------------------------------------------------------
# AUTH THROTTLE (ADR-026 / DOC-03 §13) — operational only
#--------------------------------------------------------------------
# Product sources leave capacity/window UNDEFINED. Do not invent rates
# in application code. Set BOTH capacity and seconds per surface in the
# deployment environment. If either value is missing/invalid, that
# surface fails closed (requests denied) until configured.
#
# auth.throttle.login.capacity =
# auth.throttle.login.seconds =
# auth.throttle.password_reset_request.capacity =
# auth.throttle.password_reset_request.seconds =
# auth.throttle.password_reset_verify.capacity =
# auth.throttle.password_reset_verify.seconds =
# auth.throttle.admin_recovery.capacity =
# auth.throttle.admin_recovery.seconds =

#--------------------------------------------------------------------
# PII EMAIL KEYS (ADR-008)
#--------------------------------------------------------------------
# Each value MUST be exactly 64 hexadecimal characters
# (= 32 bytes after hex2bin()).
#
# EMAIL_ENCRYPTION_KEY and EMAIL_LOOKUP_HMAC_KEY MUST be different.
# Never reuse one secret for both purposes.
# Never commit real key material.

EMAIL_ENCRYPTION_KEY =
EMAIL_LOOKUP_HMAC_KEY =

#--------------------------------------------------------------------
# SMTP (password recovery — DOC-11 / DOC-08)
#--------------------------------------------------------------------
# Credentials are environment-specific. Leave blank in this template.
# Maps to Config\Email via CodeIgniter env overrides.

email.fromEmail =
email.fromName =
email.protocol = smtp
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls
